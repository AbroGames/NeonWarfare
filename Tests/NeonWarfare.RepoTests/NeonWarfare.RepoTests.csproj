<!-- Plain Microsoft.NET.Sdk, not Godot.NET.Sdk: the tests never start the engine and must not load
     GodotSharp, which cannot initialize outside a Godot process. The one exception is compile-time only:
     GodotSharp and KludgeBox are referenced below so that GodotBoxIndependenceTests can hand them to
     Roslyn as metadata; GodotSharp without its runtime asset, so it is never copied into the output
     nor loaded into the test host. -->
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Same TFM as the game project: both live in one solution, and later the tests may
             reference its pure (non-Godot) classes without multi-targeting. -->
        <TargetFramework>net10.0</TargetFramework>

        <!-- xunit.v3 builds a self-contained test host (Microsoft.Testing.Platform). With a library
             OutputType the project still compiles, but no tests are discovered or run. -->
        <OutputType>Exe</OutputType>

        <!-- New code with no legacy, so the nullable context and implicit usings are on. This does
             not affect the game project: the "new global usings only in Scripts/GlobalUsings.cs"
             rule from Docs/Code-style.md applies to NeonWarfare.csproj. -->
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <!-- The framework itself: [Fact]/[Theory] and Assert. -->
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <!-- VSTest adapter: without it neither `dotnet test` nor the Rider runner discovers
             xunit.v3 tests. -->
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
        <!-- VSTest host: sets IsTestProject and enables the `dotnet test` target. -->
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <!-- The C# parser alone, used by the convention tests to read the game sources as syntax
             trees instead of matching regexes against lines. It is not a reference to the game
             project and pulls in no GodotSharp: nothing here is compiled or executed, only parsed. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    </ItemGroup>

    <!-- The versions are read from the game project rather than written here: the compilation in
         GodotBoxIndependenceTests is only meaningful against the GodotSharp and KludgeBox the game builds
         with, so a bump in NeonWarfare.csproj must carry over without a second edit. A regex over the
         file, not an MSBuild evaluation of it: restore reads PackageReference versions at evaluation
         time, where another project's items are out of reach, and evaluating the game project would pull
         in Godot.NET.Sdk. GodotSharp has no explicit reference in the game: Godot.NET.Sdk/<version> adds
         it implicitly with the same version (PackageVersion_GodotSharp in its SdkPackageVersions.props). -->
    <PropertyGroup>
        <GameProjectPath>$(MSBuildThisFileDirectory)..\..\NeonWarfare.csproj</GameProjectPath>
        <GameProjectText>$([System.IO.File]::ReadAllText($(GameProjectPath)))</GameProjectText>
        <GameGodotVersion>$([System.Text.RegularExpressions.Regex]::Match($(GameProjectText), 'Sdk="Godot\.NET\.Sdk/([^"]+)"').Groups[1].Value)</GameGodotVersion>
        <GameKludgeBoxVersion>$([System.Text.RegularExpressions.Regex]::Match($(GameProjectText), 'Include="KludgeBox"\s+Version="([^"]+)"').Groups[1].Value)</GameKludgeBoxVersion>
    </PropertyGroup>

    <!-- Without this an unmatched regex would leave the version empty, and NuGet silently falls back
         to the lowest available version with only a warning. -->
    <Target Name="CheckGamePackageVersions" BeforeTargets="Restore;CollectPackageReferences">
        <Error Condition="'$(GameGodotVersion)' == ''"
               Text="Could not read the Godot.NET.Sdk version from $(GameProjectPath): expected &lt;Project Sdk=&quot;Godot.NET.Sdk/x.y.z&quot;&gt;." />
        <Error Condition="'$(GameKludgeBoxVersion)' == ''"
               Text="Could not read the KludgeBox version from $(GameProjectPath): expected &lt;PackageReference Include=&quot;KludgeBox&quot; Version=&quot;x.y.z&quot; /&gt;." />
    </Target>

    <ItemGroup>
        <!-- Compile-time references for GodotBoxIndependenceTests, which compiles Src/GodotBox on its own
             with Roslyn: GodotBox may depend on the engine and on KludgeBox, never on the game.
             ExcludeAssets="runtime" on GodotSharp keeps GodotSharp.dll in @(ReferencePath) while it is
             neither copied to bin/ nor listed in deps.json — the test host cannot load it even by
             accident. The direct reference is what carries that flag: without it GodotSharp would come
             in through KludgeBox with its runtime asset.
             KludgeBox itself keeps its runtime assets: NuGet narrows the asset flags down the dependency
             chain, so excluding them there strips the Humanizer.Core.<culture> packages (satellite
             resources only) of everything and restore fails with NU1202. KludgeBox.dll, Serilog and
             Humanizer land in bin/ but are never loaded: no test code uses their types.
             GodotSharpEditor (the SDK adds it in Debug) is deliberately not here: GodotBox is runtime
             code and must build for an export as well. -->
        <PackageReference Include="GodotSharp" Version="$(GameGodotVersion)" ExcludeAssets="runtime" />
        <PackageReference Include="KludgeBox" Version="$(GameKludgeBoxVersion)" />
    </ItemGroup>

    <ItemGroup>
        <!-- The tests read repository files (Docs/, README.md), but their working directory is
             bin/<config>/<tfm>/. The root is baked into the assembly at compile time: walking up
             from AppContext.BaseDirectory is fragile because the output depth changes between
             configurations. Read back by RepositoryPaths. -->
        <AssemblyMetadata Include="RepositoryRoot" Value="$(MSBuildThisFileDirectory)..\..\" />
    </ItemGroup>

    <!-- Writes the resolved compile-time references — the reference assemblies of net10.0 plus every
         package assembly, transitive ones included — to one file next to the test assembly, one path
         per line. Read by Infrastructure/CompileReferences for GodotBoxIndependenceTests.
         @(ReferencePath) is what csc itself receives, after NuGet resolution and conflict resolution
         between the framework and packages. Rebuilding that list in the test instead (walking
         ~/.nuget/packages, finding the targeting pack under the dotnet root) would duplicate the SDK
         and silently disagree with it on a version bump.
         The list also holds the test project's own packages (xUnit, Roslyn, the test platform). They are
         kept rather than filtered: an extra reference can only make GodotBox compile where it otherwise
         would not, and anything GodotBox took from them would break the game build first, since the
         game references none of them. Filtering by package would need the transitive closure of
         KludgeBox written out by hand — one more list to go stale. -->
    <Target Name="WriteCompileReferences" AfterTargets="ResolveAssemblyReferences">
        <WriteLinesToFile File="$(OutDir)compile-references.txt"
                          Lines="@(ReferencePath->'%(FullPath)')"
                          Overwrite="true"
                          WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <FileWrites Include="$(OutDir)compile-references.txt" />
        </ItemGroup>
    </Target>
</Project>
