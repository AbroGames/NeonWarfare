<Project Sdk="Godot.NET.Sdk/4.7.1">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <RootNamespace/>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="KludgeBox" Version="4.1.5" />
        <PackageReference Include="RepliCAT" Version="1.0.1" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="MessagePack" Version="3.1.8" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    </ItemGroup>

    <PropertyGroup>
        <NoWarn>CS0649</NoWarn>
    </PropertyGroup>

    <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
        <ItemGroup>
            <DirectoriesToCreate Include="$(ProjectDir)bin\win-64" />
            <DirectoriesToCreate Include="$(ProjectDir)bin\android" />
            <FilesToCreate Include="$(ProjectDir)bin\.gdignore" />
        </ItemGroup>
        <MakeDir Directories="@(DirectoriesToCreate)" />
        <WriteLinesToFile File="@(FilesToCreate)" Lines="" Overwrite="true" />
    </Target>

    <!-- The project directory is the repository root, so the default **/*.cs glob would also pick up
         Tests/** (separate test projects). Game code lives only in Src/, so it is listed explicitly
         instead. -->
    <PropertyGroup>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Src/**/*.cs" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" />
        <None Include="Docs/**/*" />
        <None Include="Assets/**/*" />
        <None Include="Properties/launchSettings.json"/>
    </ItemGroup>
</Project>