<Project Sdk="Godot.NET.Sdk/4.7.1">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="KludgeBox" Version="4.0.0" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="MessagePack" Version="3.1.8" />
    </ItemGroup>

    <PropertyGroup>
        <NoWarn>CS0649</NoWarn>
    </PropertyGroup>

    <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
        <ItemGroup>
            <DirectoriesToCreate Include="$(ProjectDir)bin\win-64" />
            <DirectoriesToCreate Include="$(ProjectDir)bin\android" />
            <FilesToCreate Include="$(ProjectDir)bin\.gdignore" />
        </ItemGroup>
        <MakeDir Directories="@(DirectoriesToCreate)" />
        <WriteLinesToFile File="@(FilesToCreate)" Lines="" Overwrite="true" />
    </Target>

    <ItemGroup>
        <None Include="README.md" />
        <None Include="Docs/**/*" />
        <None Include="Assets/**/*" />
        <None Include="Properties/launchSettings.json"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The project directory is the repository root, so the default Godot.NET.Sdk glob
             (**/*.cs) also picks up Tests/**. Without this the game assembly would try to compile
             the test sources and fail on xUnit types it does not reference. Tests are built by
             Tests/NeonWarfare.Tests/NeonWarfare.Tests.csproj instead. -->
        <Compile Remove="Tests/**" />
        <!-- Same glob puts Tests/** (including its bin/obj) into None, cluttering the file tree in
             Rider next to the Assets/** and Docs/** items included above on purpose. -->
        <None Remove="Tests/**" />
    </ItemGroup>
</Project>